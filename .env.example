# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase Dashboard → Project Settings → API

# Public — safe to expose to the browser. Used by the anon client (RLS enforced).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server-only. Bypasses Row Level Security. NEVER expose to the browser.
# Used only for admin actions like creating contractor/staff accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the app (used for auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Contractor application form (public marketing site: /apply, /pool-contractors)
# ---------------------------------------------------------------------------
# Where submissions are delivered. Both sinks are optional and independent —
# whichever are configured receive every submission.
#
# 1) Webhook. Works with GoHighLevel inbound webhooks, Zapier catch hooks,
#    Make.com webhooks, n8n, or your own endpoint. Receives a JSON POST.
CONTRACTOR_APPLICATION_WEBHOOK_URL=
# Optional shared secret, sent as the X-HomeQuote-Secret header so the
# receiving system can verify the call came from this site.
CONTRACTOR_APPLICATION_WEBHOOK_SECRET=
#
# 2) Supabase. Uses SUPABASE_SERVICE_ROLE_KEY (already set above). Requires
#    supabase/migrations/0006_contractor_applications.sql to have been run.
#    Override only if you renamed the table.
CONTRACTOR_APPLICATIONS_TABLE=contractor_applications
#
# If NEITHER is configured, the form still works: submissions are written to
# the server log with the marker [contractor-application] so nothing is lost.
# Configure at least one before taking the site live.

# Show the dashed "drop proof assets here" placeholders on the marketing site.
# Unset -> shown in development, hidden in production. 'true'/'false' forces it.
NEXT_PUBLIC_SHOW_PROOF_PLACEHOLDERS=

# ---------------------------------------------------------------------------
# Scripts and integration tests only (never read by the app)
# ---------------------------------------------------------------------------
# Direct Postgres connection string from Supabase → Project Settings → Database.
# Used by scripts/verify-schema.mjs, scripts/verify-migration-rollback.mjs,
# scripts/import-prospects.ts and tests/calls-rls.test.ts. Server/local only.
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Refresh Prospects (/app/calls → Refresh Prospects → Find New Prospects)
# ---------------------------------------------------------------------------
# Google Places API (New) key with "Places API (New)" enabled. Server-side only.
# Without it the feature runs, explains what is missing, and adds nothing —
# it never invents businesses. Set the same value in Vercel → Production.
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# Manual prospect email (/app/calls/emails)
# ---------------------------------------------------------------------------
# Google Cloud OAuth 2.0 Web application credentials. Enable Gmail API and add
# the exact callback URL below as an Authorized redirect URI.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/oauth/callback
# Optional. Shown as `supportEmail` in email templates. Senders are chosen in the app
# (Calls > Emails): each team member connects their own Gmail, and an admin connects
# the shared automation sender, so this no longer selects who emails are sent from.
GMAIL_FROM_EMAIL=
# Optional. Google account pre-selected when an admin connects the automation sender.
# Defaults to info@homequotenet.com.
GMAIL_AUTOMATION_EMAIL=
# Base64-encoded 32-byte AES key used only on the server to encrypt the stored
# OAuth refresh token. Generate once and keep the same value across deploys:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Homeowner lead funnels (/estimate/[slug]) — see FUNNELS.md
# ---------------------------------------------------------------------------
# Server-only exact hostname allowlist for configured outbound CRM webhooks.
FUNNEL_WEBHOOK_HOSTS=services.leadconnectorhq.com
# GoHighLevel Private Integration token for the Pool Masters LA sub-account
# (Settings → Private Integrations). Server-only; never NEXT_PUBLIC_.
GHL_POOL_MASTERS_TOKEN=
# Optional Calendly personal access token: verifies funnel bookings and stores the
# appointment time. Server-only.
CALENDLY_API_TOKEN=
# Meta Conversions API (server-side ad conversion events, deduplicated against the
# browser Pixel by lib/funnels/tracking.ts via a shared event_id). The Pixel/Dataset
# ID itself is NOT an env var — it already lives per-funnel in each funnel's
# trackingPixels.metaPixelId (e.g. content/funnels/clients/pool-masters-la.json),
# since different contractor funnels can use different pixels. This token is the
# one piece that must never reach the browser; generate it per Meta Events Manager
# → Dataset → Settings → Conversions API → "Generate access token". Server-only.
# Without it, Meta event sending is a silent no-op (the funnel still works normally).
META_CONVERSIONS_API_TOKEN=
# Secret for a scheduler POST to /api/funnels/deliver (Bearer authorization).
FUNNEL_CRON_SECRET=
# Server-only bearer secret for the durable workflow event/resume worker.
WORKFLOW_CRON_SECRET=
# HomeQuote's public phone number, rendered by {{homequote.phone}} in workflow
# emails. Server-only (read by the workflow runtime; never NEXT_PUBLIC_). When
# unset, any line containing {{homequote.phone}} is left out of the message.
HOMEQUOTE_PHONE=
# Optional local QA build output isolation; leave unset in normal deployments.
NEXT_DIST_DIR=

# ---------------------------------------------------------------------------
# HomeQuote lead review & distribution (migration 0016)
# ---------------------------------------------------------------------------
# Every new lead from ANY form/intake is emailed ONLY to these addresses first
# (comma separated). Server-only; never NEXT_PUBLIC_. Sent through the
# HomeQuote Gmail connection above. Qualified leads are then sent from the
# lead page to people managed at /app/lead-recipients.
# Optional: unset = the confirmed defaults (tzarcheiliam@gmail.com, nsolachnek@gmail.com).
LEAD_ALERT_EMAILS=

# ---------------------------------------------------------------------------
# Web Push notifications (PWA) — see HOMEQUOTE_CONTEXT.md "Push notifications"
# ---------------------------------------------------------------------------
# Generate ONCE (keep the same pair across deploys, changing it drops every
# device's subscription):   npx web-push generate-vapid-keys
# Public key: shipped to the browser (NEXT_PUBLIC_ => inlined at BUILD time,
# so redeploy after setting it). Private key: server-only, never NEXT_PUBLIC_.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact the push services can reach if your sends misbehave.
VAPID_SUBJECT=mailto:support@homequotenet.com
# Optional: extra push-service hostname suffixes to accept (comma separated).
# Built in: fcm.googleapis.com, push.services.mozilla.com, push.apple.com, notify.windows.com.
PUSH_ENDPOINT_HOSTS=

# Meta Lead Ads (Instant Forms) connector — all server-only, placeholders only.
# Each falls back to the value saved on /app/integrations/meta (admin-only table) if unset.
# Webhook verify token: any random string you also paste into the Meta app's Webhooks setup.
META_WEBHOOK_VERIFY_TOKEN=
# Meta app secret (App settings -> Basic). Verifies X-Hub-Signature-256 on every delivery.
META_APP_SECRET=
# Long-lived token that can read the Page's leads (a Business Manager System User token
# with leads_retrieval is recommended; user-derived Page tokens can expire).
META_PAGE_ACCESS_TOKEN=
# Graph API version for lead retrieval (default v26.0).
META_GRAPH_VERSION=v26.0
# Meta Events Manager "Test events" code (e.g. TEST12345) for verifying server events.
# While set, EVERY server event is sent as a test event and does NOT count toward reporting or
# ad optimization. Set only during a verification session, then remove and redeploy.
META_TEST_EVENT_CODE=

# --- Meta Ads Studio (migration 0043; dormant until set AND switched on in Meta Ads > Activity & settings) ---
# System User token with ads_management on ONLY the ad accounts/Pages HQN may change. Separate from the read-only
# META_MARKETING_ACCESS_TOKEN so reporting stays low-privilege. Unset = every write path shows "Setup required".
META_ADS_WRITE_TOKEN=

# --- AI calling (Fish Audio Agents) -----------------------------------------
# Deployment master switch. Nothing places an AI call unless this is exactly "true" AND an admin has also
# enabled calling in the app (AI Agent Calls > Emergency stop / Enable calling).
AI_CALLING_GLOBAL_ENABLED=false
# Bearer secret for a scheduler POST to /api/ai-calling/tick. Generate with: openssl rand -hex 32
AI_CALLING_CRON_SECRET=
# Fish Audio API key (https://fish.audio/app/api-keys). Server-only.
FISH_API_KEY=
# Reference only (not read by code): the Fish agent id and phone-number id for each contractor are set in
# the app under AI Agent Calls > Contractors. Keep these here only as a note of what you configured.
FISH_AGENT_ID=
FISH_PHONE_NUMBER_ID=
# Signing secret WE choose (openssl rand -hex 32) and register on the Fish agent's
# webhooks.post_call entry; verifies X-Fish-Webhook-Signature on /api/ai-calling/webhook.
FISH_WEBHOOK_SECRET=

# --- Meta Ads analytics + outcome feedback (migration 0041; all optional until you set them up) ---
# Read-only System User token with ads_read on the ad accounts to report on (reporting import only).
META_MARKETING_ACCESS_TOKEN=
# Authorizes POST /api/meta/tick (the 5-minute worker in .github/workflows/meta-tick.yml).
META_TICK_SECRET=
# Optional: lets "Check connection" show token expiry.
META_APP_ID=
# HQN reporting timezone for lead dates (default America/Los_Angeles).
HQN_REPORTING_TIMEZONE=

# --- Contractor calendar sync (migration 0047; dormant until all three are set) ---
# Google Cloud OAuth client (type: Web application) with the Google Calendar API enabled. Separate from the Gmail client.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI on that client, e.g. https://app.homequotenet.com/api/integrations/google-calendar/oauth/callback
GOOGLE_CALENDAR_REDIRECT_URI=
# Optional. Base64 32-byte key (openssl rand -base64 32). Falls back to GMAIL_TOKEN_ENCRYPTION_KEY when unset.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# --- Stripe (Growth Tools checkout + admin "Send payment" links on Billing) ---
# Server-only secret key (a restricted rk_ key is fine). Needs Checkout Sessions, Payment Links, Prices, Customers, Billing Portal.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<your-domain>/api/stripe/webhook (events listed in lib/billing/webhook.ts HANDLED_EVENTS).
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# In-app assistant (Claude) — docs/assistant.md
# ---------------------------------------------------------------------------
# Server-only. Use a key from a DEDICATED Anthropic workspace that has its own spend limit. Leave auto-reload off.
ANTHROPIC_API_KEY=
# Default claude-sonnet-5-5. Any model id works; unknown ids are budgeted as the most expensive model.
ANTHROPIC_MODEL=
# low | medium | high (default low = cheapest)
ASSISTANT_EFFORT=
# Set to false to switch the assistant off everywhere.
ASSISTANT_ENABLED=
# App-side budget guards (USD, estimated from token counts). Defaults: user $1.50/day, company $20/month, organisation $100/month.
ASSISTANT_USER_DAILY_USD=
ASSISTANT_TENANT_MONTHLY_USD=
ASSISTANT_ORG_MONTHLY_USD=
# Messages per user per minute (default 8), reply length cap in tokens (default 1500), model/tool round trips per message (default 5).
ASSISTANT_RATE_LIMIT_PER_MIN=
ASSISTANT_MAX_OUTPUT_TOKENS=
ASSISTANT_MAX_TOOL_ROUNDS=

# Meta login for guided tracking setup (dormant until set). META_APP_ID / META_APP_SECRET are defined above.
# Base64 32-byte key that encrypts stored Meta user tokens (falls back to GMAIL_TOKEN_ENCRYPTION_KEY).
META_TOKEN_ENCRYPTION_KEY=
# Override only if the callback is not https://<site>/api/integrations/meta/connect/callback.
META_OAUTH_REDIRECT_URI=
