# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase Dashboard → Project Settings → API

# Public — safe to expose to the browser. Used by the anon client (RLS enforced).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server-only. Bypasses Row Level Security. NEVER expose to the browser.
# Used only for admin actions like creating contractor/staff accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the app (used for auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
